# Copy to /etc/vpngate-backend/env (root:root, mode 0600). install.sh does this for you and generates
# strong random values. NEVER commit real values. Secrets live only here, never in config.json.

# Password for the admin page / admin endpoints (HTTP Basic, username "admin"). >= 24 chars.
VPNGATE_ADMIN_SECRET=

# Optional shared key the Android app sends as the X-API-Key header. Anything shipped inside an APK can
# be extracted: this only deters casual abuse, it is not real authentication.
VPNGATE_APP_API_KEY=

# Optional overrides
# VPNGATE_DB_PATH=/var/lib/vpngate-backend/vpngate.db
